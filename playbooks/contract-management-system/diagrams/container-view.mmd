%% Contract Management container view
%% Shows major services, stores, and interaction paths.
flowchart TB
    Portal[Contract Operations UI]
    API[Contract API Boundary]

    Intake[Draft Intake and Authoring Service]
    Lifecycle[Contract Lifecycle Service]
    Workflow[Review and Approval Orchestration Service]
    Rules[Policy and Clause Evaluation Service]
    Notify[Notification and Messaging Service]
    Search[Search and Query Service]
    Audit[Audit and Provenance Service]
    Integrations[Integration and Data Movement Service]

    State[(Repository/Core State Store)]
    Index[(Search Projection Store)]
    Events[(Event and Messaging Channel)]

    Portal --> API
    API --> Intake
    API --> Lifecycle
    API --> Search

    Intake --> Lifecycle
    Lifecycle --> State
    Lifecycle --> Events

    Events --> Workflow
    Workflow --> Rules
    Workflow --> Notify
    Events --> Integrations

    Lifecycle --> Index
    Search --> Index

    API --> Audit
    Lifecycle --> Audit
    Workflow --> Audit
    Integrations --> Audit
